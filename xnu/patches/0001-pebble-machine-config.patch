diff --git a/pexpert/pexpert/arm64/PEBBLE.h b/pexpert/pexpert/arm64/PEBBLE.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/pexpert/pexpert/arm64/PEBBLE.h
@@ -0,0 +1,54 @@
+/*
+ * PEBBLE.h - board configuration for the Xiaomi SM8950 ("pebble").
+ *
+ * Modeled on the SWEET.h that ios-sweet adds for SM7150.  Differences that
+ * matter for SM8950:
+ *   - Gunyah runs at EL2, so XNU is a guest: no monitor-mode entry, PSCI and
+ *     some GIC state are proxied by the hypervisor.
+ *   - GICv3 with TrustZone owning Group 0, as on sweet, so the timer and IPIs
+ *     arrive as Group 1 IRQs through ICC_IAR1_EL1.
+ *   - The device tree reports the standard arch timer PPIs (27/26), unlike
+ *     sweet's Qualcomm-numbered 19/18.
+ *   - Oryon cores implement PAC, but XNU's arm64e ABI assumes Apple keys, so
+ *     the machine config stays plain arm64.
+ */
+#ifndef _PEXPERT_ARM64_PEBBLE_H
+#define _PEXPERT_ARM64_PEBBLE_H
+
+#define NO_MONITOR       1
+#define NO_ECORE         1
+#define NO_APPLEARMSMP   1
+
+/* XNU uses a 16K granule on arm64; SM8950 supports TGran16. */
+#define PAGE_SIZE_FIXED  1
+
+#define HAS_GIC_V3       1
+
+/*
+ * GICv3 addresses, read back from /proc/iomem on the running device:
+ *   17000000-1700ffff : GICD
+ *   17080000-1727ffff : GICR
+ */
+#define PEBBLE_GICD_BASE        0x17000000UL
+#define PEBBLE_GICD_SIZE        0x00010000UL
+#define PEBBLE_GICR_BASE        0x17080000UL
+#define PEBBLE_GICR_SIZE        0x00200000UL
+#define PEBBLE_GICR_PE_SIZE     0x00020000UL
+
+/* offsets from a redistributor frame */
+#define PEBBLE_GICR_IGROUPR0    (0x10000 + 0x080)
+#define PEBBLE_GICR_ISENABLER0  (0x10000 + 0x100)
+#define PEBBLE_GICR_IPRIORITYR  (0x10000 + 0x400)
+#define PEBBLE_GICR_IGRPMODR0   (0x10000 + 0xD00)
+
+#define PEBBLE_GICD_CTLR_ENABLEGRP1 (1u << 1)
+#define PEBBLE_GICD_CTLR_ARE_NS     (1u << 4)
+
+/* Standard arch timer PPIs on this platform (see /soc/timer@17810000) */
+#define PEBBLE_VTIMER_INTID    27
+#define PEBBLE_PTIMER_INTID    (27 - 1)
+
+/* 64-byte cache lines on Oryon (log2 = 6) */
+#define PEBBLE_CACHELINE_SHIFT 6
+
+#endif /* _PEXPERT_ARM64_PEBBLE_H */
