diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..0006d4d 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1833,21 +1833,51 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
  */
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 
-static void
+vm_offset_t sweet_early_fb_va;        /* chosen alias, for sweet_early_relocate() */
+
+#define SWEET_FB_BLOCKS 3u              /* 6 MB covers the whole panel */
+
+static vm_offset_t
 sweet_early_map_final(void)
 {
-	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
-	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
-	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
-	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
-	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
-	__asm__ volatile("dsb ishst" ::: "memory");
+	/*
+	 * PEBBLE: keep the framebuffer reachable after TTBR0 is dropped.  Three
+	 * consecutive 2 MB slots are needed (1120 x 4480 = 4.9 MB), so only a run
+	 * of free slots that is still empty after the physmap is usable.
+	 */
+	for (unsigned int i = 1; i + SWEET_FB_BLOCKS < 256; i++) {
+		vm_map_address_t va = VM_MIN_KERNEL_ADDRESS + (vm_map_address_t)i * ARM_TT_L2_SIZE;
+		if (va + SWEET_FB_BLOCKS * ARM_TT_L2_SIZE > gVirtBase) {
+			break;
+		}
+		tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+		if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) !=
+		    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+			continue;
+		}
+		tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+		tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		boolean_t free_run = TRUE;
+		for (unsigned int k = 0; k < SWEET_FB_BLOCKS; k++) {
+			if (slot[k] != ARM_TTE_EMPTY) {
+				free_run = FALSE;
+				break;
+			}
+		}
+		if (!free_run) {
+			continue;
+		}
+		for (unsigned int k = 0; k < SWEET_FB_BLOCKS; k++) {
+			slot[k] = (0xf8c00000ULL + (uint64_t)k * ARM_TT_L2_SIZE) |
+			    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+			    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+			    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) |
+			    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+		}
+		__asm__ volatile("dsb ishst" ::: "memory");
+		return va;
+	}
+	return 0;
 }
 #endif
 
@@ -2179,18 +2209,26 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	arm_set_user_tbi();
 
+	arm_vm_physmap_init(args);
 #if defined(SWEET)
-	/* phystokv() must still refer to the bootstrap aperture here. */
-	sweet_early_map_final();
+	/*
+	 * Install the alias once the physmap is final but *before* TTBR1 is
+	 * switched: phystokv() still resolves through the bootstrap aperture
+	 * here, and the entry is already in the table we are about to load.
+	 */
+	sweet_early_fb_va = sweet_early_map_final();
+	flush_mmu_tlb();
 #endif
-	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
+#if defined(SWEET)
+	sweet_early_mark(18, "final TTBR1 live");
+#endif
 
 	ml_enable_monitor();
 
 #if defined(SWEET)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(SWEET_EARLY_FB_VA);
+	sweet_early_relocate(sweet_early_fb_va + 0x60000);
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..85a2517 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,10 +515,10 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (0xf8c60000 + 2436 * 4480)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	mov		x4, #4480
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -686,7 +686,7 @@ Lkernelcache_base_found:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, 0xf8c60000
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
