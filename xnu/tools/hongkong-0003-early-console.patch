+static void
+sweet_early_hex64(uint64_t v)
+{
+	sweet_early_string("0x");
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		unsigned int nib = (unsigned int)((v >> shift) & 0xf);
+		sweet_early_putc((char)(nib < 10 ? '0' + nib : 'a' + nib - 10));
+	}
+}
+
+/* Return addresses live on the stack; a dump recovers the call chain. */
+static void
+sweet_early_dump_stack(uint64_t base, unsigned int words)
+{
+	for (unsigned int i = 0; i < words; i++) {
+		sweet_early_hex64(*(volatile uint64_t *)(uintptr_t)(base + (uint64_t)i * 8));
+		sweet_early_putc((i % 4) == 3 ? '
+' : ' ');
+	}
+	if ((words % 4) != 0) {
+		sweet_early_putc('
+');
+	}
+}
