+		sweet_early_string("STACK sp=");
+		sweet_early_hex64(sp);
+		sweet_early_putc('\n');
+		sweet_early_dump_stack(sp, 24);
+	}
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
