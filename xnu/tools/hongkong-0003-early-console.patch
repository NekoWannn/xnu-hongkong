+
+	for (unsigned int need = SWEET_FB_BLOCKS; need >= 1; need--) {
+		for (unsigned int i = 1; i + need < 256; i++) {
+			vm_map_address_t va = VM_MIN_KERNEL_ADDRESS + (vm_map_address_t)i * ARM_TT_L2_SIZE;
+			if (va + need * ARM_TT_L2_SIZE > gVirtBase) {
